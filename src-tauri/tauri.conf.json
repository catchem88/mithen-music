{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MithenMusic",
  "version": "1.0.0",
  "identifier": "com.mithenapps.mithenmusic",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MithenMusic",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
